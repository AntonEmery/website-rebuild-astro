<dialog class='lightbox' aria-label='Image viewer'>
  <button class='lightbox__close' type='button' aria-label='Close'>&times;</button>
  <button class='lightbox__prev' type='button' aria-label='Previous image'>
    &#8249;
  </button>
  <figure class='lightbox__figure'>
    <img class='lightbox__image' src='' alt='' />
    <figcaption class='lightbox__caption'>
      <span class='lightbox__caption-text'></span>
      <span class='lightbox__counter'></span>
    </figcaption>
  </figure>
  <button class='lightbox__next' type='button' aria-label='Next image'>
    &#8250;
  </button>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const image = dialog.querySelector<HTMLImageElement>('.lightbox__image')!;
  const captionText = dialog.querySelector('.lightbox__caption-text')!;
  const counter = dialog.querySelector('.lightbox__counter')!;
  const prevButton = dialog.querySelector('.lightbox__prev')!;
  const nextButton = dialog.querySelector('.lightbox__next')!;
  const closeButton = dialog.querySelector('.lightbox__close')!;

  let group: HTMLAnchorElement[] = [];
  let index = 0;

  function show(newIndex: number) {
    index = (newIndex + group.length) % group.length;
    const link = group[index];
    image.src = link.href;
    image.alt = link.dataset.alt ?? '';
    captionText.textContent = link.dataset.caption ?? '';
    counter.textContent =
      group.length > 1 ? `${index + 1} / ${group.length}` : '';
    dialog.classList.toggle('lightbox--single', group.length === 1);
  }

  document.addEventListener('click', (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>(
      'a[data-lightbox]',
    );
    // Let modifier-clicks open the image in a new tab as normal
    if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
    event.preventDefault();

    // A gallery name groups images anywhere on the page; otherwise
    // images inside the same ThumbnailGrid are grouped together
    const gallery = link.dataset.gallery;
    const grid = link.closest('[data-lightbox-group]');
    group = gallery
      ? Array.from(
          document.querySelectorAll<HTMLAnchorElement>(
            `a[data-lightbox][data-gallery="${CSS.escape(gallery)}"]`,
          ),
        )
      : grid
        ? Array.from(
            grid.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]'),
          )
        : [link];
    show(group.indexOf(link));
    dialog.showModal();
  });

  prevButton.addEventListener('click', () => show(index - 1));
  nextButton.addEventListener('click', () => show(index + 1));
  closeButton.addEventListener('click', () => dialog.close());

  // Clicking the dark area around the image closes the lightbox
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog || event.target === image.parentElement) {
      dialog.close();
    }
  });

  dialog.addEventListener('keydown', (event) => {
    if (group.length < 2) return;
    if (event.key === 'ArrowLeft') show(index - 1);
    if (event.key === 'ArrowRight') show(index + 1);
  });

  // Swipe left/right on touch screens
  let touchStartX = 0;
  dialog.addEventListener(
    'touchstart',
    (event) => {
      touchStartX = event.changedTouches[0].clientX;
    },
    { passive: true },
  );
  dialog.addEventListener('touchend', (event) => {
    const deltaX = event.changedTouches[0].clientX - touchStartX;
    if (group.length < 2 || Math.abs(deltaX) < 50) return;
    show(deltaX < 0 ? index + 1 : index - 1);
  });

  dialog.addEventListener('close', () => {
    image.src = '';
  });
</script>
